# Build output
/netbraid
/netbraid-go
/netwatch
target/
**/target/

# Dataset catalogs and other non-sensitive metadata under /data/ stay tracked.
# Corpus bytes, generated products, and local integrity receipts do not.
/data/raw/
/data/derived/
/data/receipts/

# Legacy evaluation location retained while active downloads are migrated.
/eval-data/
__pycache__/

# Maintainer planning and agent reports are local-only.
/.agents/
/docs/adr/
/docs/design/

# Private capture and replay artifacts. Reviewed fixtures belong only under
# explicit rust/tests/fixtures directories and use committed text encodings.
*.pcap
*.pcapng
*.cap
*.pcap.gz
*.pcapng.gz
*.pcap.zst
*.pcapng.zst
*.har
/events.jsonl
/audit-history.jsonl
/host-path*.jsonl
/linktop-captures/

# Local analysis, logs, databases, and credentials.
.ipynb_checkpoints/
*.ipynb
*.log
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
secrets.json
credentials.json
token.txt
*.pem
*.key
id_rsa
id_ed25519
